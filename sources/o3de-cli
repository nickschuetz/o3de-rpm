#!/usr/bin/bash
#
# o3de-cli — Open 3D Engine command-line tool wrapper
#
# Thin wrapper that forwards to <install-prefix>/scripts/o3de.sh,
# exposing the upstream O3DE Python CLI on $PATH so users don't need
# to type the full /opt/O3DE/<version>/scripts/ prefix. All
# sub-commands and arguments pass through unchanged.
#
# This source file is mutated at %install time by the spec: the
# @O3DE_INSTALL_PREFIX@ placeholder gets substituted with the
# versioned install path (e.g. /opt/O3DE/26.05.0). The installed
# binary is named per-version too — /usr/bin/o3de2605-cli for the
# 26.05 line, /usr/bin/o3de2610-cli for 26.10, etc.
#
# To see what's available (substitute the actual versioned name):
#     o3de2605-cli --help
#
# Common operations:
#     o3de2605-cli register --this-engine            # one-time per-user setup
#     o3de2605-cli get-registered                    # list registered engines/projects/gems
#     o3de2605-cli create-project --project-path ~/MyGame --project-name MyGame
#     o3de2605-cli create-gem    --gem-path ~/MyGem --gem-name MyGem
#     o3de2605-cli enable-gem  --project-path ~/MyGame --gem-name Atom
#     o3de2605-cli edit-engine-properties --display-name "My Engine"
#
# This wrapper is part of the versioned o3deNNNN RPM (o3de2605, o3de2610,
# …). The Project Manager / Editor GUI launcher is /usr/bin/o3deNNNN
# (separate command, same versioning).

o3de_prefix=@O3DE_INSTALL_PREFIX@

# O3DE's Python runtime is per-user (~/.o3de/Python), fetched by
# python/get_python.sh. Project Manager runs that on first launch, but
# o3de.sh only prints "Python has not been downloaded/configured yet" and
# exits, so the first CLI command on a new account failed (seen with
# create-project on a fresh CentOS Stream 10 install, 2026-10-21). Run it
# here too: on first use, and after an upgrade changes the Python package
# (python.sh then reports "Python has been updated"). Its output goes to
# stderr so the command's own stdout stays clean for scripts.
if ! "$o3de_prefix/python/python.sh" -c '' >/dev/null 2>&1; then
    echo "${0##*/}: setting up O3DE's Python runtime in ~/.o3de/Python (one time; needs an internet connection)" >&2
    "$o3de_prefix/python/get_python.sh" >&2 || {
        echo "${0##*/}: $o3de_prefix/python/get_python.sh failed" >&2
        exit 1
    }
fi

# A project configure also needs this engine in the user's manifest
# (cmake/EngineFinder.cmake: "Engine registration is required before
# configuring a project"). Project Manager registers it on launch and
# %post can't (it runs as root), so register it here when the manifest
# doesn't list it yet; leave it to the user when the command is register.
# The manifest stores the resolved path (manifest.get_this_engine_path()),
# which differs from the prefix where /opt is a symlink. As with Project
# Manager, registering puts this engine first in the manifest's list.
o3de_real=$(readlink -f "$o3de_prefix")
if [ "$1" != register ] &&
   ! grep -qF -e "\"$o3de_prefix\"" -e "\"$o3de_real\"" \
        "$HOME/.o3de/o3de_manifest.json" 2>/dev/null; then
    "$o3de_prefix/scripts/o3de.sh" register --this-engine >&2 ||
        echo "${0##*/}: could not register $o3de_prefix; run: ${0##*/} register --this-engine" >&2
fi

exec "$o3de_prefix/scripts/o3de.sh" "$@"
