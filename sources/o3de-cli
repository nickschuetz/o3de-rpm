#!/usr/bin/bash
#
# o3de-cli — Open 3D Engine command-line tool wrapper
#
# Thin wrapper that forwards to <install-prefix>/scripts/o3de.sh,
# exposing the upstream O3DE Python CLI on $PATH so users don't need
# to type the full /opt/O3DE/<version>/scripts/ prefix. All
# sub-commands and arguments pass through unchanged.
#
# This source file is mutated at %install time by the spec: the
# @O3DE_INSTALL_PREFIX@ placeholder gets substituted with the
# versioned install path (e.g. /opt/O3DE/26.05.0). The installed
# binary is named per-version too — /usr/bin/o3de2605-cli for the
# 26.05 line, /usr/bin/o3de2610-cli for 26.10, etc.
#
# To see what's available (substitute the actual versioned name):
#     o3de2605-cli --help
#
# Common operations:
#     o3de2605-cli register --this-engine            # one-time per-user setup
#     o3de2605-cli get-registered                    # list registered engines/projects/gems
#     o3de2605-cli create-project --project-path ~/MyGame --project-name MyGame
#     o3de2605-cli create-gem    --gem-path ~/MyGem --gem-name MyGem
#     o3de2605-cli enable-gem  --project-path ~/MyGame --gem-name Atom
#     o3de2605-cli edit-engine-properties --display-name "My Engine"
#
# This wrapper is part of the versioned o3deNNNN RPM (o3de2605, o3de2610,
# …). The Project Manager / Editor GUI launcher is /usr/bin/o3deNNNN
# (separate command, same versioning).

exec @O3DE_INSTALL_PREFIX@/scripts/o3de.sh "$@"
