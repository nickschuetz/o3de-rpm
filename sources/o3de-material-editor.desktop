[Desktop Entry]
# Material Editor entry. NoDisplay=true: this entry is intentionally hidden
# from the application menu. Material Editor requires an active project
# context to function -- launching the binary cold from the menu just
# produces "is not a valid project path" error dialogs. The canonical
# launch path is from inside the running Editor (Tools -> Material Editor),
# which inherits the project context. This desktop file still exists so
# the dock can associate our per-tool icon to the running ME window via
# StartupWMClass matching. Upstream Windows ships an equivalent Start menu
# shortcut with the same broken-cold-launch behavior; we hide ours to
# avoid surfacing the error to users who'd reasonably expect a menu entry
# to "just work."
Type=Application
Version=1.0
Name=O3DE Material Editor
GenericName=Material Authoring
Comment=Open 3D Engine standalone Material Editor
Exec=/opt/o3de/bin/Linux/profile/Default/MaterialEditor
Icon=o3de-material-editor
Terminal=false
NoDisplay=true
StartupNotify=true
StartupWMClass=O3DE MaterialEditor
Categories=Development;3DGraphics;
Keywords=o3de;material;editor;atom;rendering;
