[Desktop Entry]
# Material Canvas entry. NoDisplay=true: this entry is intentionally hidden
# from the application menu. Same rationale as o3de-material-editor.desktop:
# Material Canvas requires an active project context and produces "is not
# a valid project path" errors when launched cold from the menu. The
# canonical launch path is from inside the running Editor. Upstream
# Windows doesn't even ship a Start menu shortcut for Material Canvas at
# all; this desktop file exists only so the dock can pair our icon to a
# running MC window via StartupWMClass matching.
Type=Application
Version=1.0
Name=O3DE Material Canvas
GenericName=Node-Based Material Authoring
Comment=Open 3D Engine standalone Material Canvas
Exec=/opt/o3de/bin/Linux/profile/Default/MaterialCanvas
Icon=o3de-material-canvas
Terminal=false
NoDisplay=true
StartupNotify=true
StartupWMClass=O3DE MaterialCanvas
Categories=Development;3DGraphics;
Keywords=o3de;material;canvas;node;graph;atom;rendering;
