[Desktop Entry]
# Standalone Editor entry. The full level editor; matches Windows where
# the Editor appears in the Start menu alongside Project Manager. Power
# users can launch it directly with the project they were last working on.
# Most new users will still go through Project Manager first.
# The spec's %install mutates Exec, Icon, Name, StartupWMClass to add the
# %{o3de_major_tag} version suffix at install time.
Type=Application
Version=1.0
Name=O3DE Editor
GenericName=Game Engine Editor
Comment=Open 3D Engine Editor
Exec=/opt/o3de/bin/Linux/profile/Default/Editor
Icon=o3de-editor
Terminal=false
StartupNotify=true
StartupWMClass=O3DE Editor
Categories=Development;3DGraphics;Game;
Keywords=o3de;editor;game;engine;3d;
