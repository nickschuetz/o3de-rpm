From b5d4d6a3ad08eb7bb1f595dfc942ed8857fc9a71 Mon Sep 17 00:00:00 2001
From: Nick Schuetz <nschuetz@redhat.com>
Date: Wed, 13 May 2026 10:03:21 -0500
Subject: [PATCH] BuiltInPackages + Atom/RHI/Vulkan: gate
 vulkan-validationlayers on system

Stage 1 system-library swap convention extended to the bundled Vulkan
validation layers. Two-hunk change:

1. cmake/3rdParty/Platform/Linux/BuiltInPackages_linux_x86_64.cmake:
   wrap the `ly_associate_package(... vulkan-validationlayers ...)`
   line in `if(NOT LY_USE_SYSTEM_VULKAN_VALIDATION_LAYERS)`. Nothing
   in the engine target_link_libraries against the cmake target; it
   is purely a runtime-discovery artifact.

2. Gems/Atom/RHI/Vulkan/Code/Source/RHI/Instance.cpp: change the
   VK_LAYER_PATH SetEnv overwrite flag from 1 to 0. Bundled-engine
   installs with VK_LAYER_PATH unset get the previous behavior
   (set to exeDirectory). Distro/Flatpak/Snap launcher wrappers can
   now pre-set VK_LAYER_PATH=/usr/share/vulkan/explicit_layer.d to
   let the system loader find the system libVkLayer_khronos_validation.so.

Patch context regenerated 2026-05-13 to apply correctly on top of
Patch0006 (the umbrella mikkelsen/zlib/lz4/etc. gate) in our spec's
%autosetup ordering; earlier attempts at this hunk used pre-Patch0006
context and rejected at %prep.

Signed-off-by: Nick Schuetz <nschuetz@redhat.com>
---
 Gems/Atom/RHI/Vulkan/Code/Source/RHI/Instance.cpp   |  7 ++++++-
 .../Linux/BuiltInPackages_linux_x86_64.cmake        | 13 ++++++++++++-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/Gems/Atom/RHI/Vulkan/Code/Source/RHI/Instance.cpp b/Gems/Atom/RHI/Vulkan/Code/Source/RHI/Instance.cpp
index 418193c2..1916a89d 100644
--- a/Gems/Atom/RHI/Vulkan/Code/Source/RHI/Instance.cpp
+++ b/Gems/Atom/RHI/Vulkan/Code/Source/RHI/Instance.cpp
@@ -70,7 +70,12 @@ namespace AZ
                 AZ::Utils::GetExecutableDirectory(exeDirectory, AZ_ARRAY_SIZE(exeDirectory));
 
                 //This env var (VK_LAYER_PATH) is used by the drivers to look for VkLayer_khronos_validation.dll
-                AZ::Utils::SetEnv("VK_LAYER_PATH", exeDirectory, 1);
+                //Use overwrite=0 (respect pre-set value) so distro/flatpak/snap packagers
+                //pointing VK_LAYER_PATH at a system loader-discovery path
+                //(e.g. /usr/share/vulkan/explicit_layer.d on Linux) win over the bundled
+                //exeDirectory default. Bundled-engine installs with VK_LAYER_PATH unset
+                //fall through to the previous behavior (set to exeDirectory).
+                AZ::Utils::SetEnv("VK_LAYER_PATH", exeDirectory, 0);
 
                 RawStringList validationLayers = Debug::GetValidationLayers();
                 m_descriptor.m_optionalLayers.insert(m_descriptor.m_optionalLayers.end(), validationLayers.begin(), validationLayers.end());
diff --git a/cmake/3rdParty/Platform/Linux/BuiltInPackages_linux_x86_64.cmake b/cmake/3rdParty/Platform/Linux/BuiltInPackages_linux_x86_64.cmake
index d7e375bc..443f04d6 100644
--- a/cmake/3rdParty/Platform/Linux/BuiltInPackages_linux_x86_64.cmake
+++ b/cmake/3rdParty/Platform/Linux/BuiltInPackages_linux_x86_64.cmake
@@ -99,4 +99,15 @@ else()
     find_package(SQLite REQUIRED)
 endif()
 ly_associate_package(PACKAGE_NAME AwsIotDeviceSdkCpp-1.15.2-rev1-linux              TARGETS AwsIotDeviceSdkCpp          PACKAGE_HASH 83fc1711404d3e5b2faabb1134e97cc92b748d8b87ff4ea99599d8c750b8eff0)
-ly_associate_package(PACKAGE_NAME vulkan-validationlayers-1.2.198-rev1-linux        TARGETS vulkan-validationlayers     PACKAGE_HASH 9195c7959695bcbcd1bc1dc5c425c14639a759733b3abe2ffa87eb3915b12c71)
+# LY_USE_SYSTEM_VULKAN_VALIDATION_LAYERS gates the bundled validation
+# layer fetcher in favor of a system install (Fedora's
+# vulkan-validation-layers ships /usr/lib64/libVkLayer_khronos_validation.so
+# + /usr/share/vulkan/explicit_layer.d/VkLayer_khronos_validation.json,
+# discovered by the Vulkan loader's default search paths). Nothing in
+# the engine target_link_libraries against the validation-layer cmake
+# target; it is purely a runtime-discovery artifact. The companion
+# Instance.cpp change (overwrite=0 on the VK_LAYER_PATH SetEnv) makes
+# the engine respect a packager-set VK_LAYER_PATH.
+if(NOT LY_USE_SYSTEM_VULKAN_VALIDATION_LAYERS)
+    ly_associate_package(PACKAGE_NAME vulkan-validationlayers-1.2.198-rev1-linux        TARGETS vulkan-validationlayers     PACKAGE_HASH 9195c7959695bcbcd1bc1dc5c425c14639a759733b3abe2ffa87eb3915b12c71)
+endif()
