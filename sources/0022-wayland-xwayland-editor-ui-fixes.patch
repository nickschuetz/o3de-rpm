         void HandleFloatingWindow(QWidget* floatingWindow)
         {
+#if defined(PAL_TRAIT_LINUX_WINDOW_MANAGER_XCB)
+            // Qt gives a floating dock widget the tool window type, which becomes
+            // _NET_WM_WINDOW_TYPE_UTILITY on X11. Window managers do not let a utility window be
+            // minimized or maximized (Mutter leaves both out of _NET_WM_ALLOWED_ACTIONS), so the
+            // buttons in the floating title bar did nothing. Declare the window a normal one, which
+            // is the X11 counterpart of what the Windows implementation does with WS_EX_APPWINDOW.
+            // Qt writes the type when it applies the window flags, so do this after it has.
+            if (QGuiApplication::platformName() != QLatin1String("xcb") || !floatingWindow)
+            {
+                return;
+            }
+
+            QTimer::singleShot(0, floatingWindow, [window = QPointer<QWidget>(floatingWindow)]
+            {
+                auto* x11Application = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+                xcb_connection_t* connection = x11Application ? x11Application->connection() : nullptr;
+                if (!window || !window->isWindow() || !window->testAttribute(Qt::WA_WState_Created) || !connection)
+                {
+                    return;
+                }
+
+                const xcb_atom_t windowType = InternAtom(connection, "_NET_WM_WINDOW_TYPE");
+                const xcb_atom_t windowTypeNormal = InternAtom(connection, "_NET_WM_WINDOW_TYPE_NORMAL");
+                if (windowType == XCB_ATOM_NONE || windowTypeNormal == XCB_ATOM_NONE)
+                {
+                    return;
+                }
+
+                xcb_change_property(
+                    connection, XCB_PROP_MODE_REPLACE, static_cast<xcb_window_t>(window->winId()), windowType, XCB_ATOM_ATOM, 32, 1,
+                    &windowTypeNormal);
+                xcb_flush(connection);
+            });
+#else
