     m_renderOverlay.winId(); // Force the render overlay to create a backing native window
 
     m_viewportUi.InitializeViewportUi(this, &m_renderOverlay);
@@ -620,6 +629,18 @@ void QtViewport::ResetCursor()
 //////////////////////////////////////////////////////////////////////////
 void* QtViewport::renderOverlayHWND() const
 {
+#if defined(Q_OS_LINUX)
+    // On Wayland the native handle is the wl_surface, and Qt can destroy and re-create that
+    // surface (for example when the widget is re-parented or hidden) without changing the id
+    // cached by QWidget::winId(). Ask the QWindow, which reports the surface that exists now.
+    if (QGuiApplication::platformName() == QLatin1String("wayland"))
+    {
+        if (QWindow* overlayWindow = m_renderOverlay.windowHandle())
+        {
+            return reinterpret_cast<void*>(overlayWindow->winId());
+        }
+    }
+#endif
     return reinterpret_cast<void*>(m_renderOverlay.winId());
 }
 
