@@ -0,0 +1,37 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+#pragma once
+
+#include <AzCore/EBus/EBus.h>
+#include <AzFramework/Windowing/WindowBus.h>
+
+namespace AzFramework
+{
+    //! Lets the owner of a window report the platform surface the window presents to right now.
+    //! A window is addressed by the NativeWindowHandle it was registered with. On most platforms
+    //! that handle is the surface for the whole life of the window, and nobody needs to implement
+    //! this bus. On Wayland the windowing toolkit can destroy a window's wl_surface and create a
+    //! new one while the window lives on (Qt does this when a window changes between being a
+    //! top-level and being a child), so a renderer that holds on to the original surface has to be
+    //! able to ask for the current one.
+    class NativeWindowSurfaceRequests
+        : public AZ::EBusTraits
+    {
+    public:
+        virtual ~NativeWindowSurfaceRequests() = default;
+
+        // EBusTraits overrides ...
+        static const AZ::EBusHandlerPolicy HandlerPolicy = AZ::EBusHandlerPolicy::Single;
+        static const AZ::EBusAddressPolicy AddressPolicy = AZ::EBusAddressPolicy::ById;
+        using BusIdType = NativeWindowHandle;
+
+        //! Returns the surface the window currently presents to, or nullptr if it has none.
+        virtual void* GetCurrentNativeSurface() const = 0;
+    };
+    using NativeWindowSurfaceRequestBus = AZ::EBus<NativeWindowSurfaceRequests>;
+} // namespace AzFramework
