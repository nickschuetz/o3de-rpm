+                        const bool previousOnAbsoluteDropZone = m_dropZoneState.onAbsoluteDropZone();
+                        const Qt::DockWidgetArea area = dockAreaForPos(dragGlobalPos);
+                        if (area != Qt::NoDockWidgetArea &&
