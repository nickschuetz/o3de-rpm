+                        }
+                        drag->setPixmap(dragImage);
+                        drag->setHotSpot(QPoint(dragImage.width() / 2, 8));
+                    }
+                    drag->exec(Qt::MoveAction);
+
+                    qApp->removeEventFilter(&dragFilter);
